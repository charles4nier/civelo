# PostgreSQL — étape 1 du plan multi-tenant (docker-compose.yml pour le local)
DATABASE_URI=postgres://style_edito:style_edito@127.0.0.1:5432/style_edito

# Ancienne base MongoDB — conservée le temps de la bascule des données réelles
# (étape 11 du plan). À retirer une fois la migration terminée et validée.
MONGO_LEGACY_URI=mongodb://127.0.0.1:27017/style-edito

# Stockage S3 — MinIO en local (docker-compose.yml), un vrai fournisseur
# S3-compatible en prod (Scaleway Object Storage, Cellar...)
S3_BUCKET=style-edito-media
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=style_edito
S3_SECRET_ACCESS_KEY=style_edito_secret

# Secret Payload — générer une valeur aléatoire longue, différente par environnement
PAYLOAD_SECRET=change-me

# Domaine de la console super-admin (accès à toutes les communes, sélecteur de
# tenant visible). Tout autre domaine arrivant sur /admin est verrouillé
# automatiquement sur le tenant qui lui correspond, sans sélecteur.
SUPER_ADMIN_DOMAIN=localhost
